# ProjectLens Backend Configuration Example
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/projectlens?retryWrites=true&w=majority

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Personal Access Token (Optional)
# GITHUB_TOKEN=

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=663446059486-26k74bahmnruch1rqer5g8jmbae9i2ov.apps.googleusercontent.com

# JWT Secret for signing tokens — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
